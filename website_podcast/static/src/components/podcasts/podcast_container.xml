<templates xml:space="preserve">
    <t t-name="website_podcast.podcastContainer">
        <div class="d-flex container flex-column flex-lg-row flex-wrap o_website_podcast pt-4">
            <div class="col-12 d-flex flex-column flex-column-reverse flex-md-column flex-lg-row align-center">
                <div class="d-flex flex-row align-center col-lg-8 overflow-auto gap-2 mb-4" style="white-space:nowrap;">
                    <span class="bg-transparent border-0 text-black opacity-75 py-2" role="button">Playlists:</span>
                    <button class="channel_link text-black opacity-75 bg-transparent border-0"
                            t-attf-class="{{state.currentChannel === 0 || !state.currentChannel ? 'font-weight-bold' : ''}}"
                            t-on-click="handleChannelSelect" data-channel-id="0">
                        All
                    </button>
                    <t t-foreach="props.channels" t-as="channel" t-key="channel['id']">
                        <button t-att-data-channel-id="channel['id']"
                        t-on-click="handleChannelSelect"
                        t-attf-class="{{channel.id === state.currentChannel ? 'font-weight-bold' : ''}}"
                        class="channel_link text-black opacity-75 bg-transparent border-0"
                        t-out="channel['title']"/>
                    </t>
                </div>

                <div class="hidden d-block col-lg-1"></div>

                <div class="col-12 col-lg-3 mb-3 mb-md-4">
                    <div class="input-group h-fit-content o_website_podcast_search mb-1">
                        <input class="o_portal_podcast_input search-query form-control oe_search_box border-end-0"
                               id="podcast_name_input"
                               t-on-keypress="(event) => event.code === 'Enter' ? this.handleSearch() : ()=>{}"
                               placeholder="Search..."/>
                        <button t-on-click="handleSearch" class="btn submit_search_input border border-start-0"
                                aria-label="Search" title="Search">
                            <i class="oi oi-search"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="o_wslides_home_nav position-relative d-flex flex-column align-center col-12 col-lg-8">
                <div class="d-flex flex-column me-0">
                    <PodcastList podcasts="state.podcasts" query="state.query" removeSearchQuery="removeSearchQuery.bind(this)" />
                </div>
            </div>

            <div class="hidden d-block col-lg-1"></div>

            <aside class="mt-16 o_wslides_home_nav position-relative d-flex flex-column align-center col-12 col-lg-3">
                <div class="oe_structure oe_empty mb-4" t-if="props.links.length">
                    <h4 style="font-size: 18px; font-weight: bold" class="text-black opacity-75">Listen on:</h4>
                    <div class="d-flex flex-wrap">
                        <t t-foreach="props.links" t-as="link" t-key="link.id">
                            <a t-att-title="link['name']" t-att-href="link['url']" target="_blank"
                               class="col-6 social-link text-decoration-none d-flex align-items-center text-black">
                                <img class="me-1 rounded-2" width="28px" height="28px"
                                     t-att-src="link['icon_url'] or '/web/static/src/img/placeholder.png'"/>
                                <span class="text-black opacity-75 font-small"><t t-out="link['name']"></t></span>
                            </a>
                        </t>
                    </div>
                </div>
                <div class='o_podcast_sidebar'/>
            </aside>
        </div>
    </t>
</templates>