<templates xml:space="preserve">
    <t t-name="website_podcast.audio_player">
        <div dir="ltr" class="d-flex align-items-center gap-1 gap-sm-3 audio-player">
            <button class="play-btn" id="playPauseBtn" t-on-click="togglePlayPause">
                <img id="playPauseIcon"
                t-att-src="state.isPlaying ? '/website_podcast/static/src/img/icons/pause.svg' : '/website_podcast/static/src/img/icons/play.svg'"
                width="65"
                height="65"
                alt="Play"/>
            </button>
            <div t-ref="progress-container" class="progress-container" t-on-click="seek">
                <div id="progressBar" class="progress-bar" t-attf-style="width: #{state.progress}%"></div>
            </div>
            <div class="d-flex flex-row align-items-center controls gap-1 gap-sm-2">
                <button id="speedBtn" class="opacity-75" t-on-click="changeSpeed" t-esc="state.playbackRate + 'x'"></button>
                <div>
                    <button class="p-0" id="rewindBtn" t-on-click="rewind">
                        <img t-att-src="'/website_podcast/static/src/img/icons/backward.svg'"/>
                    </button>
                    <button class="p-0" id="forwardBtn" t-on-click="forward">
                        <img t-att-src="'/website_podcast/static/src/img/icons/forward.svg'"/>
                    </button>
                </div>
                <span class="time d-flex align-center opacity-75 ms-sm-3" id="timeDisplay">
                    <t t-esc="formatTime(state.currentTime)" /> | <t t-esc="formatTime(state.duration)" />
                </span>
            </div>
            <audio t-ref="audio"
                   t-att-src="props.audioUrl"
                   t-on-timeupdate="updateProgress"
                   t-on-loadedmetadata="updateTime"
            ></audio>
        </div>
    </t>
</templates>
