<odoo noupdate="1">
    <template id="podcasts_episode" name="Podcasts Episode page">
        <t t-name="website_podcast.podcast_handler"></t>
        <t t-set="body_classname" t-value="'o_podcast_body'"/>
        <t t-set="main_object" t-value="episode"/>
        <t t-call="website.layout">
            <div id="wrap" class="wrap o_wslides_wrap">
                <div class="bg-200 oe_structure oe_empty">
                    <div class="container o_website_podcast d-flex flex-column flex-lg-row flex-wrap">
                        <div class="mt-16 col-12 d-flex flex-column flex-lg-row align-center py-3 py-md-4">
                            <div class="d-flex flex-row align-center col-lg-8 overflow-auto"
                                 style="white-space:nowrap;">
                                <span class="py-1">Playlists: </span>
                                <span class="py-1 px-1 mx-1">
                                    <a href="/podcasts?channelId=0" class="text-dark"
                                       t-att-class="'font-weight-bod' if not channel else 'text-dark'">
                                        All
                                    </a>
                                </span>
                                <t t-foreach="channels" t-as="channel">
                                    <span class="py-1 px-1 mx-1">
                                        <a t-att-href="'/podcasts?channelId=%s' % channel['id']" class="text-dark"
                                           t-att-class="'font-weight-bold' if channel['id'] == active_channel_id else 'text-dark'">
                                            <t t-out="channel['title']"/>
                                        </a>
                                    </span>
                                </t>
                            </div>
                            <div class="hidden d-block col-lg-1"></div>

                            <div class="d-none d-md-block col-lg-3">
                                <form action="/podcasts" method="get" class="input-group h-fit-content border-0">
                                    <input class="search-query form-control oe_search_box border-0 border-end-0"
                                           name="query"
                                           aria-label="Search"
                                           placeholder="Search..."/>
                                    <button type="submit"
                                            class="btn oe_search_button bg-white border-0 border-start-0"
                                            aria-label="Search" title="Search">
                                        <i class="oi oi-search"/>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container d-flex flex-column mt-3 mt-lg-10 mb-lg-10">
                    <div class="d-block d-md-none col-12 mb-3">
                        <form action="/podcasts" method="get" class="input-group h-fit-content border rounded-pill">
                            <input class="search-query form-control oe_search_box border-0 border-end-0 rounded-pill"
                                   name="query"
                                   aria-label="Search"
                                   placeholder="Search..."/>
                            <button type="submit"
                                    class="btn oe_search_button bg-white border-0 border-start-0 rounded-pill"
                                    aria-label="Search" title="Search">
                                <i class="oi oi-search"/>
                            </button>
                        </form>
                    </div>
                    <div class="d-flex flex-column flex-lg-row">
                        <div class="col-12 col-lg-3 me-0">
                            <img t-att-src="episode.image_1920 and image_data_uri(episode.image_1920) or ''"
                                 class="website-podcast-episode-cover"/>
                        </div>
                        <div class="col-12 col-lg-9 mt-3 mb-4 mt-lg-3 ps-lg-4">
                            <div class="d-flex flex-column">
                                <div class="d-flex w-100 justify-content-between flex-row mb-2">
                                    <div>
                                        <img t-att-src="'/website_podcast/static/src/img/icons/microphone.svg'"
                                             height="21"/>
                                        <h6 class="ms-1 d-inline text-black opacity-75 font-small"><b><t
                                                t-out="episode.channel_id.title"></t></b></h6>
                                    </div>
                                    <div class="d-none d-md-flex align-center justify-content-center gap-3">
                                        <t t-name="website_podcast.share_socials">
                                            <button class="border-0 bg-transparent" id="share-twitter-btn" title="Share on X">
                                                <img t-att-src="'/website_podcast/static/src/img/icons/twitter.png'" width="20px"/>
                                            </button>
                                            <button class="border-0 bg-transparent" id="share-linkedin-btn" title="Share on Linkedin">
                                                <img t-att-src="'/website_podcast/static/src/img/icons/linkedin.svg'"/>
                                            </button>
                                        </t>
                                        <owl-component name="website_podcast.copy_link_modal"/>
                                        <div>
                                            <a title="Next Episode"
                                               t-att-href="'/podcast/%s/episode/%s' % (episode.channel_id.id, next_episode)"
                                               class="text-decoration-none"
                                               t-if="next_episode">
                                                <img src="/website_podcast/static/src/img/icons/next.svg"
                                                     width="30px"/>
                                            </a>
                                            <span t-if="not next_episode" title="No Next Episode"
                                                  class="text-decoration-none disabled">
                                                <img src="/website_podcast/static/src/img/icons/next.svg"
                                                     width="30px" style="opacity: 0.5;"/>
                                            </span>

                                            <a title="Previous Episode"
                                               t-att-href="'/podcast/%s/episode/%s' % (episode.channel_id.id, previous_episode)"
                                               class="text-decoration-none"
                                               t-if="previous_episode">
                                                <img src="/website_podcast/static/src/img/icons/previous.svg"
                                                     width="30px"/>
                                            </a>
                                            <span t-if="not previous_episode" title="No Previous Episode"
                                                  class="text-decoration-none disabled">
                                                <img src="/website_podcast/static/src/img/icons/previous.svg"
                                                     width="30px" style="opacity: 0.5;"/>
                                            </span>

                                        </div>
                                    </div>

                                </div>
                                <h4 class="mb-2 text-black font-weight-bold opacity-75"><t
                                        t-out="episode.title"/></h4>
                                <p class="text-black text-align-justify opacity-75 font-small"><t
                                        t-out="episode.short_description"/></p>

                                <t t-if="episode.file_url">
                                    <owl-component name="website_podcast.audio_player" t-att-props="json.dumps({
                                        'audioUrl': episode.file_url,
                                    })"/>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-light rounded-5">
                                        <i class="fa fa-warning ms-1 me-2"/>|
                                        <b>امکان پخش این اپیزود وجود ندارد، لطفا بعدا تلاش کنید!</b>
                                    </div>
                                </t>

                                <div class="d-flex font-small flex-column flex-md-row align-center text-black mt-4 justify-content-between">
                                    <div class="d-flex align-center">
                                        <img t-if="episode.contributors"
                                             t-att-src="'/website_podcast/static/src/img/icons/contributor.svg'"
                                             height="19" class="me-1"/>
                                        <div class="contributors">
                                            <t t-foreach="episode.contributors" t-as="contributor"
                                               class="opacity-50">
                                                <span>
                                                    <t t-out="contributor.name"></t><span class="virgool">،</span>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                    <ul class="d-flex align-center gap-3 ps-0 mt-2 mt-md-0">
                                        <li class="sub-metadata" style="list-style: none">
                                            <svg class="me-1" width="3" height="3" viewBox="0 0 3 3" fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <circle opacity="0.8" cx="1.5" cy="1.5" r="1.5" fill="#4D4D4D"/>
                                            </svg>
                                            <time t-field="episode.create_date" class="text-nowrap fw-bold"
                                                  t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'long'}"/>
                                        </li>
                                        <li class="sub-metadata" style="list-style: none">
                                            <svg class="me-1" width="3" height="3" viewBox="0 0 3 3" fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <circle opacity="0.8" cx="1.5" cy="1.5" r="1.5" fill="#4D4D4D"/>
                                            </svg>
                                            <t t-out="episode.channel_id.title"></t></li>
                                        <li class="sub-metadata" style="list-style: none">
                                            <svg class="me-1" width="3" height="3" viewBox="0 0 3 3" fill="none"
                                                 xmlns="http://www.w3.org/2000/svg">
                                                <circle opacity="0.8" cx="1.5" cy="1.5" r="1.5" fill="#4D4D4D"/>
                                            </svg>
                                            Episode: <t t-out="episode_of"></t></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 mb-5 mt-lg-5">
                        <section>
                            <h4 class="border-start border-danger ps-2 mb-3 heading-text"
                                style="font-size: 22px; border-width: 2px !important;">Description</h4>
                            <div class="text-align-justify mb-4 mb-lg-0">
                                <t t-out="episode.description" t-options="{'widget': 'html'}"></t>
                            </div>
                        </section>
                        <div class="d-flex d-md-none align-center justify-content-center mt-5 mt-lg-0 gap-3">
                            <t t-name="website_podcast.share_socials">
                                <button class="border-0 bg-transparent" id="share-twitter-btn">
                                    <img t-att-src="'/website_podcast/static/src/img/icons/twitter.png'" width="20px"/>
                                </button>
                                <button class="border-0 bg-transparent" id="share-linkedin-btn">
                                    <img t-att-src="'/website_podcast/static/src/img/icons/linkedin.svg'"/>
                                </button>
                            </t>
                            <t t-name="website_podcast.copy_link_modal">
                                <button class="border-0 bg-transparent copy-link-button" id="copy-link-button">
                                    <img t-att-src="'/website_podcast/static/src/img/icons/share.svg'"/>
                                </button>
                            </t>


                            <div>
                                <a title="Next Episode"
                                   t-att-href="'/podcast/%s/episode/%s' % (episode.channel_id.id, next_episode)"
                                   class="text-decoration-none"
                                   t-if="next_episode">
                                    <img src="/website_podcast/static/src/img/icons/next.svg"
                                         width="30px"/>
                                </a>
                                <span t-if="not next_episode" title="No Next Episode"
                                      class="text-decoration-none disabled">
                                    <img src="/website_podcast/static/src/img/icons/next.svg"
                                         width="30px" style="opacity: 0.5;"/>
                                </span>

                                <a title="Previous Episode"
                                   t-att-href="'/podcast/%s/episode/%s' % (episode.channel_id.id, previous_episode)"
                                   class="text-decoration-none"
                                   t-if="previous_episode">
                                    <img src="/website_podcast/static/src/img/icons/previous.svg"
                                         width="30px"/>
                                </a>
                                <span t-if="not previous_episode" title="No Previous Episode"
                                      class="text-decoration-none disabled">
                                    <img src="/website_podcast/static/src/img/icons/previous.svg"
                                         width="30px" style="opacity: 0.5;"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div itemprop="description" class="oe_structure oe_empty mt0" id="podcast_top_description"/>
                    <div t-attf-class="mx-auto #{readableClass}">
                    <div id="o_wblog_post_comments" t-attf-class="pt-4 o_container_small">
                        <div groups="base.group_public" class="small mb-4">
                            <a href="/web/login?redirect=/blog/{{slug(blog_post.blog_id)}}/{{slug(blog_post)}}#discussion" class="btn btn-sm btn-primary"><b>Sign in</b></a> to leave a comment
                        </div>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="episode"/>
                        </t>
                    </div>
                </div>
                <section class="s_text_block pt0 pb0 o_colored_level about-podcast" data-snippet="s_text_block"
                         data-name="Text">
                    <div class="bg-lines container position-absolute">
                        <i></i>
                        <i></i>
                        <i></i>
                    </div>
                    <div class="container s_allow_columns">
                        <div class="row d-flex align-items-center justify-between">
                            <div class="col-right d-flex flex-column p-0 py-8 px-3 px-md-0">
                                <h3>About radio Tashilgostar</h3>
                                <p>
                                    Tashilgostar Radio, built on the extensive experience and knowledge of the company
                                    in supporting and launching electronic businesses on comprehensive Enterprise
                                    Resource Planning (ERP) systems, is designed to provide you with practical tips and
                                    actionable insights to optimize your organization and improve your business
                                    performance.
                                </p>
                                <p>We are here to pave the way for the comprehensive and integrated digital
                                    transformation of your business, based on best practices.</p>
                                <div class="buttons d-flex gap-1 justify-content-lg-between">
                                    <a class="btn btn-outline-secondary">Sazmanyar Introduction Videos</a>
                                    <a class="btn btn-outline-secondary">Free Trial</a>
                                    <a class="btn btn-outline-secondary">Request a Free Consultation or Demo</a>
                                </div>
                            </div>
                            <div class="col-left p-0 d-none d-lg-block">
                                <img src="/website_podcast/static/src/img/about_podcast.svg"/>
                            </div>
                        </div>
                    </div>
                </section>
                <div itemprop="description" class="oe_structure oe_empty mt0" id="podcast_bottom_description"/>
            </div>
        </t>
    </template>
</odoo>
