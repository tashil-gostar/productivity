<odoo>
    <template id="podcasts_home" name="Podcasts Homepage">
        <t t-set="body_classname" t-value="'o_podcast_body'" />
        <t t-call="website.layout">
            <div id="wrap" class="wrap o_wslides_wrap">
                <div class="oe_structure oe_empty">
                    <section class="s_banner overflow-hidden d-flex align-center"
                        style="height: 445px; background-color:purple; background-image: url(&quot;/website_podcast/static/src/img/cover_podcast.jpg&quot;); background-size: cover; background-position: 55% 65%"
                        data-snippet="s_banner">
                        <div class="container align-items-center d-flex">
                            <div style="max-width: 600px;" class="text-white">
                                <h4 class="mb-3" style="font-size: 28px;">Your Podcast Brand</h4>
                                <div class="row mt-1 mb-3">
                                    <div class="col">
                                        <p class="mb-3 text-align-justify">
                                            Lorem ipsum dolor sit amet, consectetur adipisicing
                                            elit. Adipisci
                                            aspernatur delectus deserunt dolor ducimus ea esse
                                            eveniet, ex laboriosam
                                            minus necessitatibus nobis obcaecati officia?
                                        </p>
                                        <p class="text-align-justify">
                                            Lorem ipsum dolor sit amet, consectetur adipisicing
                                            elit.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <owl-component name="website_podcast.podcastContainer"
                    t-att-props="json.dumps({'channels': channels, 'links': links})" />
            </div>
        </t>
    </template>
</odoo>