<odoo>
    <record id="website_podcast_episode_view_form" model="ir.ui.view">
        <field name="name">website.podcast.episode.view.form</field>
        <field name="model">website.podcast.episode</field>
        <field name="arch" type="xml">
            <form string="Podcast Episode">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button" />
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'preview_image': 'image_128'}" />

                    <div class="oe_title">
                        <label for="title" string="Episode Title" />
                        <h1>
                            <field name="title" default_focus="1"
                                placeholder='e.g. "Example podcast episode"' />
                        </h1>
                    </div>

                    <div>
                        <label string="Short Description" for="short_description" />
                        <field name="short_description"
                            placeholder="Describe what's happening in this episode in few lines" />
                    </div>

                    <notebook colspan="4">
                        <page name="options" string="Options">
                            <group>
                                <group name="properties" string="Properties">
                                    <field name="channel_id" widget="many2one" />
                                    <field name="formatted_duration" string="Duration" />
                                    <field name="file_url" string="Podcast audio link" />
                                </group>
                                <group name="contributors" string="Contributors">
                                    <field name="contributors" widget="many2many_avatar_user" />
                                </group>
                            </group>
                            <group>
                                <group name="display" string="Display">
                                    <field name="active" string="Active episode" />
                                    <field name="is_published" string="Show on website"
                                        options="{'horizontal': True}" />

                                </group>
                                <group name="seo_properties" string="SEO Options">
                                    <field name="website_meta_title" string="Meta Title" />
                                    <field name="website_meta_description" string="Meta Description" />
                                    <field name="website_meta_keywords" string="Meta Keywords"
                                        help="Separate every keyword with a comma" />
                                    <field name="seo_name" string="SEO Name" />
                                </group>
                            </group>
                        </page>

                        <page name="description" string="Description">
                            <field name="description" widget="html" nolabel="1"
                                placeholder="Provide a detailed overview of this episode..." />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_podcast_episode_kanban" model="ir.ui.view">
        <field name="name">podcast.episode.view.kanban</field>
        <field name="model">website.podcast.episode</field>
        <field name="arch" type="xml">
            <kanban edit="false" sample="1"
                class="o_emphasize_colors o_kanban_dashboard o_channel_kanban">
                <field name="id" />
                <field name="title" />
                <field name="color" />
                <field name="short_description" />
                <field name="duration" />
                <field name="create_date" />
                <temapltes>
                    <t t-name="kanban-menu">
                        <div class="o_dropdown_kanban dropdown">
                            <div role="menuitem" aria-haspopup="true"
                                class="o_no_padding_kanban_colorpicker">
                                <ul class="oe_kanban_colorpicker" data-field="color" role="popup" />
                            </div>
                            <div class="o_kanban_card_manage_pane">
                                <div role="menuitem" aria-haspopup="true"
                                    class="o_no_padding_kanban_colorpicker">
                                    <ul class="oe_kanban_colorpicker" data-field="color"
                                        role="popup" />
                                </div>
                                <div class="o_kanban_slides_card_manage_pane">
                                    <t t-if="widget.deletable">
                                        <a role="menuitem" type="delete" class="dropdown-item">
                                            Delete</a>
                                    </t>
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title mb16">
                                    <div class="o_primary">
                                        <a type="edit" class="me-auto">
                                            <span>
                                                <field name="title" class="o_primary" />
                                            </span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content mt0">
                                <div class="row mb16">
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="d-flex" name="info_total_time">
                                            <span class="me-auto">
                                                <label for="formatted_duration" class="mb0">
                                                    Duration</label>
                                            </span>
                                            <field name="formatted_duration" />
                                        </div>
                                    </div>
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="d-flex" name="info_total_time">
                                            <span class="me-auto">
                                                <label for="website_visitor_count" class="mb0">
                                                    Vistors</label>
                                            </span>
                                            <field name="website_visitor_count" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row border-top pt-2 mt3">
                                    <div class="col-2">
                                        <span class="text-muted">Channel: </span>
                                    </div>
                                    <div
                                        class="col-10 d-flex justify-content-center align-items-center">
                                        <a name="action_visit_channel" type="object" class="fw-bold">
                                            <field
                                                name="channel_id" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </temapltes>
            </kanban>
        </field>
    </record>

    <record id="website_podcast_episode_form_action" model="ir.actions.act_window">
        <field name="name">Podcast Episode</field>
        <field name="res_model">website.podcast.episode</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="website_podcast_episode_view_form" />
        <field name="target">current</field>
    </record>
</odoo>