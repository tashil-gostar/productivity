<odoo>
    <record id="website_podcast_link_view_form" model="ir.ui.view">
        <field name="name">website.podcast.link.view.form</field>
        <field name="model">website.podcast.link</field>
        <field name="arch" type="xml">
            <form string="Podcast Link">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar" />

                    <div class="oe_title">
                        <label for="name" string="Link title" />
                        <h3>
                            <field name="name" default_focus="1" placeholder="e.g. Spotify" />
                        </h3>
                    </div>

                    <label for="url" string="Link" />
                    <field name="url" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_podcast_link_view_list" model="ir.ui.view">
        <field name="name">website.podcast_link_view_list</field>
        <field name="model">website.podcast.link</field>
        <field name="arch" type="xml">
            <list class="o_podcast_link_list">
                <field name="icon" widget="image" class="social-icon" />
                <field name="name" />
                <field name="url" />
            </list>
        </field>
    </record>
</odoo>