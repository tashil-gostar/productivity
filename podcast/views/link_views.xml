<odoo>
    <record id="view_podcast_link_form" model="ir.ui.view">
        <field name="name">podcast.link.view.form</field>
        <field name="model">podcast.link</field>
        <field name="arch" type="xml">
            <form string="Podcast Link">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name" string="Link title"></label>
                        <h3>
                            <field name="name" default_focus="1" placeholder="e.g. Spotify"></field>
                        </h3>
                    </div>

                    <label for="url" string="Link"></label>
                    <field name="url"></field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_podcast_link_list" model="ir.ui.view">
        <field name="name">podcast.link.view.list</field>
        <field name="model">podcast.link</field>
        <field name="arch" type="xml">
            <list class="o_podcast_link_list">
                <field name="icon" widget="image" class="social-icon"/>
                <field name="name"/>
                <field name="url"/>
            </list>
        </field>
    </record>

    <record id="action_website_podcast_link" model="ir.actions.act_window">
        <field name="name">Links</field>
        <field name="res_model">podcast.link</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
