<odoo>
    <record model="ir.ui.view" id="view_podcast_channel_form">
        <field name="name">podcast.channel.view.form</field>
        <field name="model">podcast.channel</field>
        <field name="arch" type="xml">
            <form string="Channels">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>

                    <div class="oe_title">
                        <label for="title" string="Channel Title"/>
                        <h1><field name="title" default_focus="1"
                                   placeholder="Pick a name for you podcast playlist"></field></h1>
                    </div>

                    <div>
                        <label string="Short Description" for="short_description"/>
                        <field name="short_description"
                               placeholder="Describe what's happening in this podcast in few lines"/>
                    </div>

                    <notebook colspan="4">
                        <page name="episodes" string="Episodes">
                            <field name="episodes" string="Episode" colspan="4" nolabel="1"
                                   mode="list,kanban"
                                   context="{'default_channel_id': id}">
                                <list>
                                    <field name="id"/>
                                    <field name="title"/>
                                    <field name="short_description"/>
                                    <field name="create_date" widget="date"/>
                                    <field name="active"/>

                                    <control>
                                        <button
                                                string="Import from Shenoto"
                                                icon="fa-upload"
                                                name="action_podcast_episode_wizard"
                                                type="object">From Shenoto</button>
                                        <create name="add_podcast_episode" string="Add Episode"/>
                                    </control>
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" widget="html" nolabel="1"
                                   placeholder="Common tasks for a computer scientist is asking the right questions...."/>
                        </page>
                        <page name="options" string="Options">
                            <group>
                                <group name="properties" string="Properties">
                                    <field name="active" string="Active channel"/>
                                </group>
                            </group>
                            <group>
                                <group name="display" string="Display">

                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_podcast_channel_kanban">
        <field name="name">podcast.channel.view.kanban</field>
        <field name="model">podcast.channel</field>
        <field name="arch" type="xml">
            <kanban edit="false" sample="1"
                    class="o_emphasize_colors o_kanban_dashboard o_channel_kanban breadcrumb_item active">
                <field name="id"/>
                <field name="title"/>
                <field name="color"/>
                <field name="short_description"/>
                <field name="image_128"/>
                <field name="formatted_duration"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-menu">
                        <div class="o_dropdown_kanban dropdown">
                            <div role="menuitem" aria-haspopup="true" class="o_no_padding_kanban_colorpicker">
                                <ul class="oe_kanban_colorpicker" data-field="color" role="popup"/>
                            </div>
                            <div class="o_kanban_card_manage_pane">
                                <div role="menuitem" aria-haspopup="true"
                                     class="o_no_padding_kanban_colorpicker">
                                    <ul class="oe_kanban_colorpicker" data-field="color" role="popup"/>
                                </div>
                                <div class="o_kanban_slides_card_manage_pane">
                                    <t t-if="widget.deletable">
                                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    </t>
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="ribbon ribbon-top-right"
                                 invisible="active">
                                <field name="active" invisible="1"/>
                                <span class="text-bg-danger">Archived</span>
                            </div>
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title mb16">
                                    <div class="o_primary">
                                        <a type="edit" class="me-auto">
                                            <span><field name="title" class="o_primary"/></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content mt0">
                                <div class="row mb16">
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="d-flex align-items-center">
                                            <span class="me-auto"><label for="total_episodes" class="mb-0">
                                                Episodes: </label></span>
                                            <field name="total_episodes"/>
                                        </div>
                                    </div>
                                    <div class="col-6 o_kanban_primary_left">
                                        <div class="d-flex" name="info_total_time">
                                            <span class="me-auto"><label for="formatted_duration" class="mb0">
                                                Duration: </label></span>
                                            <field name="formatted_duration"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt3">
                                    <div class="col-9 border-end">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold"><field name="contributors"/></span>
                                            <span class="text-muted">Contributors</span>
                                        </div>
                                    </div>
                                    <div class="col-3 border-end">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-bold"><field name="links_length"/></span>
                                            <span class="text-muted">Links</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="view_podcast_channel_list">
        <field name="name">website_podcast.channel.view.list</field>
        <field name="model">podcast.channel</field>
        <field name="arch" type="xml">
            <list string="Channels">
                <field name="id"/>
                <field name="title"/>
                <field name="short_description"/>
                <field name="image_128" widget="image"/>
            </list>
        </field>
    </record>
</odoo>
